<?xml version="1.0" encoding="utf-8"?>
<!-- Copia este archivo como appsettings.local.config (sin ".example") y pon tus datos reales.
     appsettings.local.config esta en .gitignore: no se sube a GitHub. -->
<appSettings>
  <add key="DB_HOST" value="gateway01.us-east-1.prod.aws.tidbcloud.com" />
  <add key="DB_PORT" value="4000" />
  <add key="DB_NAME" value="proyectoDB" />
  <add key="DB_USER" value="TU_USUARIO" />
  <add key="DB_PASS" value="TU_CONTRASENA" />
</appSettings>
